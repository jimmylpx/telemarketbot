# ============================================================
# Bot Telegram Auto-Order & DANA Auto-Check Gateway
# Template Konfigurasi Environment (.env)
# ============================================================

# ------------------------------------------------------------
# 1. KONFIGURASI BOT TELEGRAM
# ------------------------------------------------------------
# Token bot Telegram dari @BotFather (contoh: 1234567890:ABCdef...)
TELEGRAM_BOT_TOKEN=

# ID Telegram angka milik Admin untuk menerima notifikasi & akses panel admin
# (Dapatkan ID Anda dengan mengirim pesan ke @userinfobot di Telegram)
ADMIN_USER_ID=

# Nama toko yang ditampilkan pada bot dan chat pelanggan
SHOP_NAME=NamaTokoAnda


# ------------------------------------------------------------
# 2. QRIS DANA BISNIS & METODE PEMBAYARAN
# ------------------------------------------------------------
# Aktifkan auto-check mutasi notifikasi DANA (true/false)
DANA_AUTO_CHECK=true

# Payload QRIS Statis DANA Bisnis (format EMVCo standard, diawali 000201010211...)
# Dapatkan dengan upload gambar QRIS DANA Bisnis Anda ke https://qris-dana-converter.vercel.app/
# atau scan barcode QRIS menggunakan aplikasi QR Scanner.
QRIS_BASE_PAYLOAD=

# Nama Merchant pemilik QRIS (sesuai nama toko pada aplikasi DANA)
MERCHANT_NAME=

# Info pembayaran manual (opsional / fallback)
PAYMENT_BANK=QRIS DANA Bisnis
PAYMENT_NUMBER=QRIS Dinamis
PAYMENT_NAME=


# ------------------------------------------------------------
# 3. WEBHOOK SERVER & CLOUDFLARE TUNNEL
# ------------------------------------------------------------
# Host dan Port lokal untuk server webhook DANA & Admin Panel
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8085

# Custom path untuk webhook DANA (default: /webhook/dana)
DANA_WEBHOOK_PATH=/webhook/dana

# Secret token keamanan untuk webhook notifikasi DANA dari MacroDroid
WEBHOOK_SECRET=ganti_dengan_token_rahasia_acak_disini

# Aktifkan Cloudflare Quick Tunnel (try.cloudflare.com)
# Jika true, bot otomatis membuat tunnel HTTPS gratis tanpa perlu domain / port forwarding
USE_CLOUDFLARE_TUNNEL=true

# URL Publik yang dapat diakses dari internet (hanya wajib jika USE_CLOUDFLARE_TUNNEL=false)
# Jika USE_CLOUDFLARE_TUNNEL=true, URL akan diisi otomatis dari trycloudflare.com
PUBLIC_URL=https://toko.domainanda.com

# Batas waktu pembayaran sebelum order kedaluwarsa (dalam menit)
ORDER_EXPIRE_MINUTES=30


# ------------------------------------------------------------
# 4. ADMIN WEB PANEL
# ------------------------------------------------------------
# Custom path untuk panel admin (default: /admin, contoh lain: /kelola /panel /secretadmin)
ADMIN_WEB_PATH=/admin

# Password untuk login ke panel admin web
ADMIN_WEB_PASSWORD=ganti_password_admin_disini

# Kunci rahasia untuk enkripsi session cookie panel admin
ADMIN_SESSION_SECRET=ganti_secret_session_acak_disini


# ------------------------------------------------------------
# 5. DATABASE & PENYIMPANAN STOK
# ------------------------------------------------------------
# Lokasi file database SQLite (relatif atau absolut)
DB_PATH=data/bot.db

# Folder penyimpanan file salinan pesanan pelanggan
ORDERS_DIR=orders

# Folder penyimpanan file-file stok produk
STOCKS_DIR=data/stocks

# File stok default (opsional / fallback)
STOCK_FILE_PATH=data/stocks/default_stock.txt
