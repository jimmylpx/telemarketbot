#!/usr/bin/env bash
# ==============================================================================
# CLI Pengelolaan TeleMarketBot
# Perintah cepat: status, log, restart, start, stop, url
# ==============================================================================

# Warna Terminal
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Deteksi root / sudo
SUDO=""
if [ "$EUID" -ne 0 ]; then
    if command -v sudo >/dev/null 2>&1; then
        SUDO="sudo"
    fi
fi

# Cari direktori kerja dari systemd
WORKDIR=$(systemctl show -p WorkingDirectory --value telemarketbot.service 2>/dev/null)
if [ -z "$WORKDIR" ] || [ ! -d "$WORKDIR" ]; then
    if [ -f "bot.py" ] && [ -f "requirements.txt" ]; then
        WORKDIR=$(pwd)
    elif [ -d "/home/$USER/telemarketbot" ]; then
        WORKDIR="/home/$USER/telemarketbot"
    else
        WORKDIR="/opt/telemarketbot"
    fi
fi

cmd_status() {
    echo -e "${CYAN}${BOLD}"
    echo "=================================================================="
    echo "              🤖 TELEMARKETBOT STATUS & OVERVIEW"
    echo "=================================================================="
    echo -e "${NC}"

    # 1. Cek Service Bot
    BOT_STATE=$(systemctl is-active telemarketbot.service 2>/dev/null || echo "inactive")
    BOT_PID=$(systemctl show -p MainPID --value telemarketbot.service 2>/dev/null || echo "0")
    if [ "$BOT_STATE" = "active" ]; then
        echo -e "● Bot Service      : ${GREEN}${BOLD}[ACTIVE / BERJALAN]${NC} (PID: $BOT_PID)"
    else
        echo -e "● Bot Service      : ${RED}${BOLD}[INACTIVE / BERHENTI]${NC}"
    fi

    # 2. Cek Service Tunnel
    TUNNEL_INSTALLED=false
    if systemctl list-unit-files telemarketbot-tunnel.service 2>/dev/null | grep -q "telemarketbot-tunnel"; then
        TUNNEL_INSTALLED=true
        TUNNEL_STATE=$(systemctl is-active telemarketbot-tunnel.service 2>/dev/null || echo "inactive")
        TUNNEL_PID=$(systemctl show -p MainPID --value telemarketbot-tunnel.service 2>/dev/null || echo "0")
        if [ "$TUNNEL_STATE" = "active" ]; then
            echo -e "● Cloudflare Tunnel: ${GREEN}${BOLD}[ACTIVE / ONLINE]${NC} (PID: $TUNNEL_PID)"
        else
            echo -e "● Cloudflare Tunnel: ${RED}${BOLD}[INACTIVE / OFFLINE]${NC}"
        fi
    else
        echo -e "● Cloudflare Tunnel: ${YELLOW}[TIDAK DIAKTIFKAN / CUSTOM DOMAIN]${NC}"
    fi

    # 3. Cek Auto-Start on Boot
    BOT_ENABLED=$(systemctl is-enabled telemarketbot.service 2>/dev/null || echo "disabled")
    if [ "$BOT_ENABLED" = "enabled" ]; then
        echo -e "● Auto-Start Boot  : ${GREEN}ENABLED${NC} (Otomatis start saat server nyala/reboot)"
    else
        echo -e "● Auto-Start Boot  : ${YELLOW}DISABLED${NC}"
    fi

    # 4. Ambil URL Publik Aktif
    LIVE_URL=""
    if [ -f "$WORKDIR/.current_tunnel_url" ]; then
        LIVE_URL=$(cat "$WORKDIR/.current_tunnel_url" 2>/dev/null | tr -d '[:space:]')
    fi
    if [ -z "$LIVE_URL" ] && [ -f "$WORKDIR/.env" ]; then
        LIVE_URL=$(grep "^PUBLIC_URL=" "$WORKDIR/.env" 2>/dev/null | cut -d'=' -f2- | tr -d '"'"'" | tr -d '[:space:]')
    fi

    # 5. Ambil Port dari .env
    PORT="8085"
    if [ -f "$WORKDIR/.env" ]; then
        ENV_PORT=$(grep "^WEBHOOK_PORT=" "$WORKDIR/.env" 2>/dev/null | cut -d'=' -f2 | tr -d '[:space:]')
        if [ -n "$ENV_PORT" ]; then
            PORT="$ENV_PORT"
        fi
    fi

    echo -e "\n${BOLD}🌐 INFORMASI AKSES LIVE:${NC}"
    if [ -n "$LIVE_URL" ] && [ "$LIVE_URL" != "https://try.cloudflare.com" ]; then
        echo -e "• Public URL       : ${CYAN}${BOLD}${LIVE_URL}${NC}"
        echo -e "• Web Admin Panel  : ${YELLOW}${BOLD}${LIVE_URL}/admin${NC}"
        echo -e "• Webhook QRIS     : ${GREEN}${BOLD}${LIVE_URL}/webhook/dana${NC}"
    else
        echo -e "${YELLOW}URL publik belum tersedia atau sedang proses generating. Tunggu beberapa detik lalu jalankan kembali.${NC}"
    fi

    echo -e "\n${BOLD}⚙️ DETAIL SISTEM:${NC}"
    echo -e "• Direktori Kerja  : ${WORKDIR}"
    echo -e "• Port Lokal       : ${PORT}"
    echo -e "=================================================================="
}

cmd_log() {
    echo -e "${BLUE}[*] Membuka log realtime TeleMarketBot...${NC}"
    echo -e "${YELLOW}[i] Tekan Ctrl+C kapan saja untuk KELUAR dari tampilan log (Server TETAP BERJALAN).${NC}\n"
    trap 'echo -e "\n${GREEN}[+] Berhasil keluar dari log. Server tetap berjalan di background.${NC}"; exit 0' INT TERM
    
    if systemctl list-unit-files telemarketbot-tunnel.service 2>/dev/null | grep -q "telemarketbot-tunnel"; then
        journalctl -u telemarketbot -u telemarketbot-tunnel -f --no-hostname "$@"
    else
        journalctl -u telemarketbot -f --no-hostname "$@"
    fi
}

cmd_restart() {
    echo -e "${BLUE}[*] Merestart layanan TeleMarketBot...${NC}"
    $SUDO systemctl restart telemarketbot
    if systemctl list-unit-files telemarketbot-tunnel.service 2>/dev/null | grep -q "telemarketbot-tunnel"; then
        echo -e "${BLUE}[*] Merestart Cloudflare Quick Tunnel...${NC}"
        $SUDO systemctl restart telemarketbot-tunnel
    fi
    echo -e "${GREEN}[+] Selesai! Layanan telah di-restart.${NC}"
    sleep 2
    cmd_status
}

cmd_start() {
    echo -e "${BLUE}[*] Menjalankan TeleMarketBot...${NC}"
    $SUDO systemctl start telemarketbot
    $SUDO systemctl enable telemarketbot >/dev/null 2>&1 || true
    if systemctl list-unit-files telemarketbot-tunnel.service 2>/dev/null | grep -q "telemarketbot-tunnel"; then
        $SUDO systemctl start telemarketbot-tunnel
        $SUDO systemctl enable telemarketbot-tunnel >/dev/null 2>&1 || true
    fi
    echo -e "${GREEN}[+] TeleMarketBot & Tunnel berhasil dijalankan dan diaktifkan saat boot.${NC}"
    sleep 2
    cmd_status
}

cmd_stop() {
    echo -e "${YELLOW}[*] Menghentikan TeleMarketBot...${NC}"
    $SUDO systemctl stop telemarketbot
    if systemctl list-unit-files telemarketbot-tunnel.service 2>/dev/null | grep -q "telemarketbot-tunnel"; then
        $SUDO systemctl stop telemarketbot-tunnel
    fi
    echo -e "${GREEN}[+] TeleMarketBot & Tunnel berhasil dihentikan.${NC}"
}

cmd_url() {
    LIVE_URL=""
    if [ -f "$WORKDIR/.current_tunnel_url" ]; then
        LIVE_URL=$(cat "$WORKDIR/.current_tunnel_url" 2>/dev/null | tr -d '[:space:]')
    fi
    if [ -z "$LIVE_URL" ] && [ -f "$WORKDIR/.env" ]; then
        LIVE_URL=$(grep "^PUBLIC_URL=" "$WORKDIR/.env" 2>/dev/null | cut -d'=' -f2- | tr -d '"'"'" | tr -d '[:space:]')
    fi
    if [ -n "$LIVE_URL" ]; then
        echo -e "${BOLD}Public URL  :${NC} $LIVE_URL"
        echo -e "${BOLD}Admin Panel :${NC} $LIVE_URL/admin"
        echo -e "${BOLD}Webhook QRIS:${NC} $LIVE_URL/webhook/dana"
    else
        echo -e "${RED}URL belum tersedia. Cek dengan 'telemarketbot status'${NC}"
    fi
}

cmd_help() {
    echo -e "${CYAN}${BOLD}TeleMarketBot CLI Management Tool${NC}"
    echo -e "Penggunaan: ${BOLD}telemarketbot <perintah>${NC}\n"
    echo -e "Perintah Tersedia:"
    echo -e "  ${GREEN}status${NC}    Lihat status bot, tunnel, URL live & admin panel dalam 1 tampilan"
    echo -e "  ${GREEN}log${NC}       Pantau log realtime bot & tunnel (Ctrl+C hanya keluar log, server tetap aman)"
    echo -e "  ${GREEN}restart${NC}   Restart server bot & cloudflare tunnel"
    echo -e "  ${GREEN}start${NC}     Jalankan bot & tunnel (sekaligus aktifkan auto-start saat reboot)"
    echo -e "  ${GREEN}stop${NC}      Hentikan server bot & tunnel"
    echo -e "  ${GREEN}url${NC}       Cetak link live publik & panel admin saat ini"
    echo -e "  ${GREEN}help${NC}      Tampilkan bantuan ini"
}

case "$1" in
    status)
        cmd_status
        ;;
    log|logs)
        shift
        cmd_log "$@"
        ;;
    restart)
        cmd_restart
        ;;
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    url)
        cmd_url
        ;;
    help|--help|-h|"")
        if [ -z "$1" ]; then
            cmd_status
        else
            cmd_help
        fi
        ;;
    *)
        echo -e "${RED}Perintah '$1' tidak dikenali.${NC}"
        cmd_help
        exit 1
        ;;
esac
